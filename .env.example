PORT=3000
SESSION_SECRET=change_this_session_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# PostgreSQL Connection (Recommended for Render / Cloud Deploy)
# DATABASE_URL=postgres://user:password@host:5432/master_canteen

# Optional MySQL Fallback
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=master_canteen

# Optional Google OAuth 2.0
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_CALLBACK_URL=https://your-app.onrender.com/auth/google/callback
# RESTRICT_EMAIL_DOMAIN=

# Optional Cashfree Sandbox/Production Keys
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=your_cashfree_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
