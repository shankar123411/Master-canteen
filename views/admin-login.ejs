<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Master Canteen - Admin Login</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #0f172a;
            --panel: #1e293b;
            --line: #334155;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --brand: #f59e0b;
            --brand-hover: #d97706;
            --radius: 12px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', 'Outfit', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background: var(--bg); color: var(--text-main); height: 100vh; display: flex; justify-content: center; align-items: center; padding: 1rem; }

        .login-card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 2.5rem; width: 100%; max-width: 410px; display: flex; flex-direction: column; gap: 1.5rem; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5); }
        .login-header h1 { font-size: 1.55rem; font-weight: 800; color: var(--brand); }
        .login-header p { font-size: 0.9rem; color: var(--text-muted); margin-top: 0.25rem; }

        .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
        .form-group label { font-size: 0.85rem; font-weight: 600; color: var(--text-muted); }

        .input-wrapper { position: relative; display: flex; align-items: center; }
        .form-input { width: 100%; padding: 0.75rem 2.75rem 0.75rem 1rem; border: 1px solid var(--line); border-radius: 8px; background: #0f172a; color: var(--text-main); font-size: 0.95rem; }
        .form-input:focus { outline: none; border-color: var(--brand); }

        .eye-btn { position: absolute; right: 0.65rem; background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 0.25rem; display: flex; align-items: center; justify-content: center; border-radius: 6px; transition: color 0.15s; }
        .eye-btn:hover { color: var(--brand); }

        .btn-submit { background: var(--brand); color: #0f172a; border: none; padding: 0.85rem; border-radius: 8px; font-weight: 700; font-size: 1rem; cursor: pointer; }
        .btn-submit:hover { background: var(--brand-hover); }

        .error-msg { background: #7f1d1d; color: #fca5a5; padding: 0.6rem 0.8rem; border-radius: 6px; font-size: 0.85rem; display: none; }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="login-header">
            <h1>Master Canteen Admin</h1>
            <p>Enter administrative credentials to proceed</p>
        </div>

        <div id="errorBox" class="error-msg"></div>

        <form id="loginForm" autocomplete="off" style="display:flex; flex-direction:column; gap:1.25rem;">
            <div class="form-group">
                <label for="usernameInput">Admin ID / Username</label>
                <div class="input-wrapper">
                    <input type="text" id="usernameInput" name="mc_admin_id" class="form-input" placeholder="Enter Admin ID" autocomplete="off" spellcheck="false" required>
                    <button type="button" class="eye-btn" onclick="toggleInputVisibility('usernameInput', this)" aria-label="Toggle Admin ID visibility" title="Show / Hide Admin ID">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                </div>
            </div>
            <div class="form-group">
                <label for="passwordInput">Password</label>
                <div class="input-wrapper">
                    <input type="password" id="passwordInput" name="mc_admin_secret" class="form-input" placeholder="Enter Password" autocomplete="new-password" required>
                    <button type="button" class="eye-btn" onclick="toggleInputVisibility('passwordInput', this)" aria-label="Toggle Password visibility" title="Show / Hide Password">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                </div>
            </div>
            <button type="submit" class="btn-submit">Sign In to Dashboard</button>
        </form>
    </div>

<script>
    const EYE_OPEN_SVG = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
    const EYE_OFF_SVG = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>';

    function toggleInputVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        if (!input) return;
        const isHidden = input.type === 'password';
        input.type = isHidden ? 'text' : 'password';
        btn.innerHTML = isHidden ? EYE_OFF_SVG : EYE_OPEN_SVG;
        btn.style.color = isHidden ? 'var(--brand)' : 'var(--text-muted)';
    }

    document.getElementById('loginForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const errBox = document.getElementById('errorBox');
        errBox.style.display = 'none';

        const username = document.getElementById('usernameInput').value;
        const password = document.getElementById('passwordInput').value;

        try {
            const res = await fetch('/api/v1/admin/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password })
            });

            const data = await res.json();
            if (!res.ok) throw new Error(data.message || 'Invalid credentials');

            window.location.href = '/admin';
        } catch (err) {
            errBox.textContent = err.message;
            errBox.style.display = 'block';
        }
    });
</script>
</body>
</html>
