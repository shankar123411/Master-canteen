<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kitchen Screen Security Login | Master Canteen</title>
    <style>
        :root {
            --bg: #0f172a;
            --panel: #1e293b;
            --panel-border: #334155;
            --gold: #d4af37;
            --gold-glow: rgba(212,175,55,0.4);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --brand: #0d9488;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background: var(--bg); color: var(--text-main); display: flex; justify-content: center; align-items: center; min-height: 100dvh; padding: 1rem; overflow-x: hidden; }

        .login-card { background: var(--panel); border: 1px solid var(--gold); border-radius: 24px; padding: clamp(1.5rem, 4vw, 2.5rem); width: 100%; max-width: 420px; box-shadow: 0 25px 50px rgba(0,0,0,0.8), 0 0 20px var(--gold-glow); display: flex; flex-direction: column; gap: 1.5rem; text-align: center; }

        .chef-icon-box { width: 80px; height: 80px; background: #020617; border: 2px solid var(--gold); border-radius: 50%; margin: 0 auto; display: flex; justify-content: center; align-items: center; font-size: 2.5rem; box-shadow: 0 0 20px var(--gold-glow); }

        h2 { font-size: 1.5rem; color: var(--gold); font-weight: 800; }
        p { color: var(--text-muted); font-size: 0.88rem; line-height: 1.4; }

        .form-group { display: flex; flex-direction: column; gap: 0.5rem; text-align: left; }
        label { font-size: 0.8rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
        .input-wrapper { position: relative; display: flex; align-items: center; }
        input { width: 100%; background: #090d16; border: 1px solid var(--panel-border); color: white; padding: 0.85rem 2.75rem 0.85rem 1rem; border-radius: 12px; font-size: 1rem; outline: none; transition: border-color 0.2s; }
        input:focus { border-color: var(--gold); box-shadow: 0 0 10px var(--gold-glow); }
        .eye-btn { position: absolute; right: 0.75rem; background: none; border: none; color: var(--text-muted); cursor: pointer; display: flex; align-items: center; padding: 0.25rem; }
        .eye-btn:hover { color: var(--gold); }

        .btn-login { background: linear-gradient(135deg, #d4af37, #b48a1d); color: black; font-weight: 800; border: none; padding: 0.9rem; border-radius: 12px; font-size: 1rem; cursor: pointer; box-shadow: 0 4px 15px var(--gold-glow); transition: transform 0.1s; }
        .btn-login:active { transform: scale(0.98); }

        .err-msg { background: rgba(220, 38, 38, 0.2); border: 1px solid #ef4444; color: #fca5a5; padding: 0.75rem; border-radius: 10px; font-size: 0.85rem; display: none; }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="chef-icon-box">👨‍🍳</div>
        <div>
            <h2>Master Canteen KDS</h2>
            <p style="margin-top:0.3rem;">Authorized Kitchen Staff Access Only</p>
        </div>

        <div class="err-msg" id="loginErr">Invalid Username or Security PIN Code!</div>

        <form id="chefLoginForm" autocomplete="off" style="display:flex; flex-direction:column; gap:1.25rem;">
            <div class="form-group">
                <label for="chefUsername">Chef Username / ID</label>
                <div class="input-wrapper">
                    <input type="text" id="chefUsername" placeholder="Enter Chef ID" autocomplete="off" required>
                    <button type="button" class="eye-btn" onclick="toggleChefInput('chefUsername', this)" aria-label="Toggle Chef ID visibility">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                </div>
            </div>
            <div class="form-group">
                <label for="chefPassword">Security Password / PIN</label>
                <div class="input-wrapper">
                    <input type="password" id="chefPassword" placeholder="Enter Security PIN" autocomplete="new-password" required>
                    <button type="button" class="eye-btn" onclick="toggleChefInput('chefPassword', this)" aria-label="Toggle Password visibility">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                </div>
            </div>
            <button type="submit" class="btn-login">Unlock Kitchen Display Screen 👨‍🍳</button>
        </form>
    </div>

<script>
    const EYE_OPEN_SVG = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
    const EYE_OFF_SVG = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>';

    function toggleChefInput(id, btn) {
        const el = document.getElementById(id);
        if (!el) return;
        const isHidden = el.type === 'password';
        el.type = isHidden ? 'text' : 'password';
        btn.innerHTML = isHidden ? EYE_OFF_SVG : EYE_OPEN_SVG;
        btn.style.color = isHidden ? 'var(--gold)' : 'var(--text-muted)';
    }

    document.getElementById('chefLoginForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const u = document.getElementById('chefUsername').value;
        const p = document.getElementById('chefPassword').value;
        const errBox = document.getElementById('loginErr');
        errBox.style.display = 'none';

        try {
            const res = await fetch('/api/v1/kitchen/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username: u, password: p })
            });

            if (res.ok) {
                window.location.href = '/kitchen/screen';
            } else {
                errBox.style.display = 'block';
            }
        } catch (err) {
            errBox.style.display = 'block';
        }
    });
</script>
</body>
</html>
